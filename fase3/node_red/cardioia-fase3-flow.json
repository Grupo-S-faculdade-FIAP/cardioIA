    {
        "id": "72a67da70dba0696",
        "type": "function",
        "z": "0862a29bc8751350",
        "name": "Verificar Alertas",
        "func": "\nconst dados = msg.payload;\n\nif (!dados || typeof dados !== \"object\") {\n    return null;\n}\n\nconst alertas = [];\n\n// So analisa BPM quando a estimativa e valida.\nif (dados.bpm_valido === true &&\n    typeof dados.bpm === \"number\" &&\n    dados.bpm > 120) {\n    alertas.push(\"BPM simulado elevado\");\n}\n\n// DHT22 mede temperatura ambiental.\nif (typeof dados.temperatura === \"number\" &&\n    dados.temperatura > 38) {\n    alertas.push(\"Temperatura ambiental elevada\");\n}\n\nif (alertas.length > 0) {\n    msg.payload = \"ALERTA: \" + alertas.join(\" | \");\n} else {\n    msg.payload = \"Monitoramento sem alertas ativos\";\n}\n\nreturn msg;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
