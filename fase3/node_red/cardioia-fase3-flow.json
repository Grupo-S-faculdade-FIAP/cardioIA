    {
        "id": "7eb254c076ad8038",
        "type": "function",
        "z": "0862a29bc8751350",
        "name": "Processar BPM",
        "func": "\nconst dados = msg.payload;\n\n// Verifica se o payload e um objeto JSON.\nif (!dados || typeof dados !== \"object\") {\n    return null;\n}\n\n// Ignora leituras sem BPM valido.\nif (dados.bpm_valido !== true) {\n    return null;\n}\n\n// Verifica se o BPM e numerico.\nif (typeof dados.bpm !== \"number\") {\n    return null;\n}\n\n// Prepara o valor para o grafico.\nmsg.payload = dados.bpm;\nmsg.topic = \"BPM simulado\";\n\nreturn msg;\n",
        "outputs": 1,
